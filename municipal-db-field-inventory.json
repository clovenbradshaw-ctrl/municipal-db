    "operations": {
      "ins": { "content": { "anchor": { "type": "string", "required": true }, "entity_type": { "type": "string", "required": true }, "payload": { "type": "object", "required": true, "note": "entity fields; becomes state.entities[anchor] = {...payload, _anchor, _type, _created, _sender, _eventId, _hwm}" } }, "stored": true },
      "def": { "content": { "anchor": { "type": "string", "required": false, "note": "absent when path starts with _schema. — schema-level DEF" }, "path": { "type": "string", "required": true, "note": "dot path via setPath; may set nested entity fields or _schema.* keys" }, "value": { "type": "any", "required": true } }, "stored": true, "note": "also records entity._fieldTs[path] = ts and _updatedBy" },
      "con": { "content": { "source_anchor": { "type": "string", "required": true }, "target_anchor": { "type": "string", "required": true }, "relation_type": { "type": "string", "required": true } }, "stored": true, "note": "fold drops any payload on CON — the app relies only on entity payloads + _schema for consumable data; missing endpoints push a cartesian_product violation" },
      "eva": { "content": { "anchor": { "type": "string", "required": true }, "criterion": { "type": "string", "required": true }, "result": { "type": "string", "required": true }, "note": { "type": "string", "required": false } }, "stored": true, "note": "appends to entity._evaluations; pushes criterionless_judgment violation if entity._hwm < DEF.order" },
      "seg": { "content": { "anchor": { "type": "string", "required": true }, "partition": { "type": "string", "required": true, "note": "open|resolved|violated|deleted (compliance workbench uses deleted for its recycle bin)" } }, "stored": true, "note": "sets state.partitions[anchor] and entity._partition" },
      "rec": { "content": { "scope": { "type": "string", "required": true }, "before_frame": { "type": "any", "required": true }, "after_frame": { "type": "any", "required": true } }, "stored": true, "note": "appends to state.frames — the record of schema change; blind_restructuring violation if folded with no EVA and no frames" },
      "syn": { "content": { "input_anchors": { "type": "string[]", "required": false }, "output": { "type": "object", "required": true } }, "stored": true, "note": "creates state.entities[syn_{eventId}] with _type '_synthesis' and _inputs" },
      "nul": { "stored": false, "note": "existence triad, order 0" },
      "sig": { "stored": false, "note": "existence triad, order 1" }
    }
  },
  "fold_output": {
    "state.entities": { "type": "object<anchor, entity>", "note": "INS payload + _meta; entity._hwm is the highest op order applied to it" },
