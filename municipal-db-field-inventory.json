      "anchor": { "type": "string", "required": false, "note": "INS only — denormalized copy of content.anchor (parity with Matrix); genSTRData writes it top-level" },
      "_deleted": { "type": "boolean", "required": false, "note": "runtime recycle-bin flag; dispatch() treats flagged events as no-ops without removing them" },
      "_deletedAt": { "type": "number", "required": false, "note": "runtime — undo timestamp, sorts the recycle bin" }
